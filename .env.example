PORT=3000
HOST=0.0.0.0
DATA_DIR=./data
DATABASE_FILE=machbar.db
BASE_PATH=/
SEED_DATABASE=true

# Optional: configure all four to require Pocket ID authentication.
# OIDC_ISSUER_URL=https://pocketid.example.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_PUBLIC_URL=https://machbar.example.com
# OIDC_SESSION_TTL_DAYS=30

# Optional: configure all three to enable Web Push notifications.
# Generate keys with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=https://machbar.example.com
